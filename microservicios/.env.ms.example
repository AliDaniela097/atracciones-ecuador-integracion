# Configuración compartida de los 13 microservicios nuevos (copie a .env.ms; NUNCA suba .env.ms a Git).
# Cadena de conexión a CUALQUIER base del servidor Postgres/Neon donde vivirán las 13 bases (ms_identity, ms_catalog, ...).
# El nombre de la base se reemplaza por el de cada servicio y se crean solas al arrancar (necesita permiso CREATE DATABASE).
MS_DB_BASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Administrador inicial de ms_identity (se crea una vez si no hay ningún ADMIN). Mínimo 8 caracteres.
MS_ADMIN_EMAIL=admin@ejemplo.ec
MS_ADMIN_PASSWORD=
# identity = exige token (recomendado) | off = sin autenticación (SOLO pruebas locales)
MS_AUTH_MODE=identity
# true = ms_identity devuelve los tokens de verificación/recuperación en la respuesta (solo pruebas: no hay servicio de correo)
MS_EXPOSE_TOKENS=false
# Conexiones máximas por servicio (cada uno tiene su pool). 13 servicios x 3 = 39 conexiones.
MS_POOL_MAX=3
