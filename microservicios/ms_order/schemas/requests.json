{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ms_order — JSON Schema de las peticiones (v1.0.0)",
  "description": "Reglas de datos de cada petición gRPC. Los campos salen de la base ms_order del equipo. Se validan con AJV en ejecución y se prueban con npm run test:schemas.",
  "$defs": {
    "OrderItemInput": {
      "type": "object", "additionalProperties": false, "required": ["atr_id", "det_descripcion", "det_cantidad", "det_precio_unitario"],
      "properties": {
        "atr_id": { "type": "integer", "minimum": 1 },
        "det_descripcion": { "type": "string", "minLength": 1, "maxLength": 255 },
        "det_cantidad": { "type": "integer", "minimum": 1, "maximum": 100 },
        "det_precio_unitario": { "type": "number", "minimum": 0, "multipleOf": 0.01 }
      }
    },
    "CreateOrderRequest": {
      "type": "object", "additionalProperties": false, "required": ["usu_id", "items"],
      "properties": {
        "usu_id": { "type": "integer", "minimum": 1 },
        "car_id": { "type": "integer", "minimum": 1 },
        "mpa_id": { "type": "integer", "minimum": 1, "maximum": 32767 },
        "items": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/OrderItemInput" } },
        "cup_ids": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "ord_descuento": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "ord_iva": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "ord_moneda": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "USD" },
        "ord_observaciones": { "type": "string", "maxLength": 500 },
        "idempotency_key": { "type": "string", "format": "uuid" }
      }
    },
    "GetOrderRequest": {
      "type": "object", "additionalProperties": false,
      "properties": { "ord_id": { "type": "integer", "minimum": 1 }, "ord_numero": { "type": "string", "minLength": 3, "maxLength": 20 } },
      "oneOf": [{ "required": ["ord_id"] }, { "required": ["ord_numero"] }]
    },
    "ListOrdersRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "usu_id": { "type": "integer", "minimum": 1 },
        "est_codigo": { "type": "string", "enum": ["CREADA", "PAGADA", "CANCELADA", "REEMBOLSADA"] },
        "page": { "type": "integer", "minimum": 1 }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "UpdateOrderStatusRequest": {
      "type": "object", "additionalProperties": false, "required": ["ord_id", "est_codigo"],
      "properties": { "ord_id": { "type": "integer", "minimum": 1 }, "est_codigo": { "type": "string", "enum": ["PAGADA", "CANCELADA", "REEMBOLSADA"] } }
    }
  }
}
