# ms_inventory — copie a .env y complete. NUNCA suba .env a Git.
# Base de datos PROPIA de este microservicio (en Neon: cree la base "ms_inventory" y copie su connection string, terminada en ?sslmode=require)
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.us-east-2.aws.neon.tech/ms_inventory?sslmode=require
GRPC_PORT=50061

# --- Cliente gRPC hacia Booking (inventory.proto) ---
GRPC_ENABLED=true
SERVICE_ID=NODE_ATR_ALISSON
# Local/mock: localhost:50051 (BOOKING_GRPC_TLS=false) · Producción Render: rda1-backend-integracion-sistemas.onrender.com:50051 (BOOKING_GRPC_TLS=true)
BOOKING_GRPC_TARGET=localhost:50051
BOOKING_GRPC_TLS=false
# Si Booking no responde, se reintenta el envío cada N milisegundos (los datos siguen guardados en la base)
GRPC_RETRY_MS=15000
