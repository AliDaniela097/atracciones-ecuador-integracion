{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ms_audit — esquemas de petición",
  "version": "1.0.0",
  "x-generado": "GENERADO desde src/definicion.mjs con contratos/exportar-esquemas.mjs (code-first). No editar a mano: cambie el código y vuelva a exportar.",
  "$defs": {
    "evento": {
      "type": "object",
      "required": [
        "tipo",
        "origen"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "tipo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "origen": {
          "type": "string",
          "maxLength": 40
        },
        "usu_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "entidad": {
          "type": "string",
          "maxLength": 60
        },
        "entidad_id": {
          "type": "string",
          "maxLength": 64
        },
        "datos": {
          "type": "object"
        },
        "ip": {
          "type": "string",
          "maxLength": 45
        },
        "en": {
          "type": "string"
        }
      }
    },
    "lote": {
      "type": "object",
      "required": [
        "eventos"
      ],
      "properties": {
        "eventos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "tipo",
              "origen"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64
              },
              "tipo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "origen": {
                "type": "string",
                "maxLength": 40
              },
              "usu_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "entidad": {
                "type": "string",
                "maxLength": 60
              },
              "entidad_id": {
                "type": "string",
                "maxLength": 64
              },
              "datos": {
                "type": "object"
              },
              "ip": {
                "type": "string",
                "maxLength": 45
              },
              "en": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "lista": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "usu_id": {
          "type": "integer"
        },
        "accion": {
          "type": "string",
          "maxLength": 60
        },
        "entidad": {
          "type": "string",
          "maxLength": 60
        },
        "entidad_id": {
          "type": "string",
          "maxLength": 64
        },
        "desde": {
          "type": "string",
          "format": "date-time"
        },
        "hasta": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
