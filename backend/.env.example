# ===== Copie este archivo a .env y complete los valores. NUNCA suba .env a Git. =====

# Neon (Postgres). Cópiela desde Neon → Dashboard → Connect → "Connection string" (debe terminar en ?sslmode=require)
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

PORT=3000
# Pública: la que Booking usará para llegar a esta tienda (para /health y los enlaces .ics)
PUBLIC_BASE_URL=http://localhost:3000/api/v3

# --- Seguridad ---
# Genere uno largo y aleatorio:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Claves X-API-Key que Booking usará para llamar a esta tienda (separadas por coma). Acuerde la clave con el líder.
BOOKING_API_KEYS=
# Administrador inicial (lo crea/actualiza `npm run db:seed`)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=
# Orígenes permitidos para el frontend (coma). * = cualquiera (solo desarrollo)
CORS_ORIGINS=http://localhost:5173

# --- Identidad de la tienda ante Booking ---
SERVICE_ID=NODE_ATR_ALISSON
NODE_ID=node-atracciones-alisson-01
PROVIDER_ID=proveedor-atracciones-alisson
PROVIDER_NAME=Atracciones Ecuador (Alisson Basantes)

# --- gRPC hacia Booking (tienda = cliente) ---
GRPC_ENABLED=true
# Local sin Docker: localhost:50051 · Dentro de Docker hacia el host: host.docker.internal:50051 · Render: rda1-backend-integracion-sistemas.onrender.com:50051
BOOKING_GRPC_TARGET=localhost:50051
# true para Render (TLS); false para localhost/Docker (h2c)
BOOKING_GRPC_TLS=false
GRPC_DISPATCH_INTERVAL_MS=2000
GRPC_RETRY_MS=30000

# true = valida la cédula con módulo 10 (el contrato lo exige con 422). Ponga false SOLO si Booking prueba con cédulas de ejemplo inválidas.
VALIDATE_CEDULA=true

# ---- Bus de eventos RabbitMQ (CloudAMQP) ----
# AMQP_URL es SECRETA: se define SOLO como variable de entorno en Azure (nunca aquí ni en Git). Sin ella el bus queda desactivado.
# AMQP_URL=
# AMQP_EXCHANGE=booking.events
# AMQP_QUEUE=q.atracciones.alisson.eventos
# AMQP_BIND_KEYS=order.confirmed,saga.compensate,payment.refunded
# Dónde viaja el identificador de la reserva en el evento (se prueban en orden; solo se actúa si es una reserva NUESTRA):
# AMQP_ID_FIELDS=data.reservation_code,data.external_order_id,data.reservationCode,data.reservation_id,data.order_id,data.booking_id,data.id,subject
# Cómo se informa el stock: grpc | rest | amqp  (con amqp se publica stock.updated en el bus con confirmación del broker)
# BOOKING_STOCK_MODE=rest
# Aviso de check-in a Booking (contrato v3.1); se deduce de BOOKING_REST_STOCK_URL si no se define:
# BOOKING_CHECKIN_URL=https://booking-core-api.azurewebsites.net/api/v3/reservas/{id}/checkin
# BOOKING_CHECKIN_ID=code
