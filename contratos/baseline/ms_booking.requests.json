{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ms_booking — JSON Schema de las peticiones (v1.0.0)",
  "description": "Reglas de datos de cada petición gRPC. Los campos salen de la base ms_booking del equipo. Se validan con AJV en ejecución y se prueban con npm run test:schemas.",
  "$defs": {
    "PassengerInput": {
      "type": "object", "additionalProperties": false, "required": ["pax_nombre"],
      "properties": {
        "pax_nombre": { "type": "string", "minLength": 2, "maxLength": 120 },
        "pax_documento": { "type": "string", "pattern": "^([0-9]{10}|[A-Z]{1,2}[0-9]{6,9})$" },
        "pax_fecha_nacimiento": { "type": "string", "format": "date" },
        "pax_es_titular": { "type": "boolean" }
      }
    },
    "CreateReservationRequest": {
      "type": "object", "additionalProperties": false, "required": ["det_id", "dis_id", "res_adultos", "res_precio_unitario", "pasajeros"],
      "properties": {
        "det_id": { "type": "integer", "minimum": 1 },
        "dis_id": { "type": "integer", "minimum": 1 },
        "res_adultos": { "type": "integer", "minimum": 1, "maximum": 100 },
        "res_ninos": { "type": "integer", "minimum": 0, "maximum": 100 },
        "res_precio_unitario": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "res_observaciones": { "type": "string", "maxLength": 500 },
        "pasajeros": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/PassengerInput" } }
      }
    },
    "ReservationRef": {
      "type": "object", "additionalProperties": false,
      "properties": { "res_uuid": { "type": "string", "format": "uuid" }, "res_codigo": { "type": "string", "pattern": "^DEC-[A-Z0-9]{6}$" } },
      "oneOf": [{ "required": ["res_uuid"] }, { "required": ["res_codigo"] }]
    },
    "CancelReservationRequest": {
      "type": "object", "additionalProperties": false, "required": ["res_motivo_cancelacion"],
      "properties": {
        "res_uuid": { "type": "string", "format": "uuid" }, "res_codigo": { "type": "string", "pattern": "^DEC-[A-Z0-9]{6}$" },
        "res_motivo_cancelacion": { "type": "string", "minLength": 3, "maxLength": 255 }
      },
      "oneOf": [{ "required": ["res_uuid"] }, { "required": ["res_codigo"] }]
    },
    "ListReservationsRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "est_codigo": { "type": "string", "enum": ["PENDIENTE_PAGO", "CONFIRMADA", "CANCELADA", "COMPLETADA"] },
        "det_id": { "type": "integer", "minimum": 1 }, "dis_id": { "type": "integer", "minimum": 1 },
        "page": { "type": "integer", "minimum": 1 }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  }
}
